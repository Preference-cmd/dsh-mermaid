{
  "name": "dsh-mermaid",
  "version": "0.1.0",
  "description": "Mermaid diagram tool and tool card for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-tool": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.4",
    "@types/react": "^19.2.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
